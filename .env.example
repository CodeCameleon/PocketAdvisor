# The template for the .env file used by docker compose.

# POSTGRES_DB must match ConnectionStrings:DefaultDatabase in appsettings.*.json
# when the backend runs outside Docker.
POSTGRES_DB=PocketAdvisor

# POSTGRES_USER and POSTGRES_PASSWORD must match ConnectionStrings:DefaultUsername
# and ConnectionStrings:DefaultPassword in the SecureStore.
POSTGRES_USER=DUMMY_USER
POSTGRES_PASSWORD=DUMMY_PASSWORD

# Host port of the database, published only on 127.0.0.1 (optional, default: 5432)
POSTGRES_PORT=5432

# Build argument and image tag of the API and web images (optional, default: development)
APP_VERSION=0.1.0

# Host port of the API, published only on 127.0.0.1 (optional, default: 5078)
# If you change it, update apiUrl in Frontend/src/environments/environment.ts as well.
API_PORT=5078

# Development enables Swagger, the data seeding and detailed error messages.
# Use it for local development only (optional, default: Production)
ASPNETCORE_ENVIRONMENT=Development

# Host port of the frontend, published only on 127.0.0.1 (optional, default: 4200)
# It must match Frontend:BaseUrl in the backend appsettings, otherwise CORS rejects the calls.
WEB_PORT=4200

# Angular build configuration of the web image (optional, default: production).
ANGULAR_CONFIGURATION=development
