{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=../database.db;"
  },
  "JsonWebToken": {
    "Issuer": "http://localhost:5078",
    "Audience": "http://localhost:5078"
  },
  "SecureStore": {
    "StorePath": "./secrets.bin",
    "KeyFilePath": "./secrets.key"
  },
  "TokenExpirations": {
    "EmailVerificationHours": 24,
    "JsonWebMinutes": 15,
    "PasswordResetMinutes": 30,
    "RefreshDays": 14
  }
}
