# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.cs        text eol=lf
*.ts        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.xml       text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env       text eol=lf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.db        binary
